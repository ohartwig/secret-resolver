{
    "name": "moselwal/secret-resolver",
    "type": "typo3-cms-extension",
    "description": "Runtime secret resolution for TYPO3 site configuration — cascading lookup from secret files, /run/secrets/ mounts, and environment variables via %secret(KEY)% placeholder syntax.",
    "license": "MIT",
    "keywords": [
        "typo3",
        "secrets",
        "docker-secrets",
        "env",
        "configuration",
        "12factor"
    ],
    "authors": [
        {
            "name": "Moselwal Digitalagentur GmbH",
            "email": "support@moselwal.de",
            "homepage": "https://moselwal.de",
            "role": "Maintainer"
        },
        {
            "name": "Kai Ole Hartwig",
            "email": "o.hartwig@moselwal.de",
            "role": "Developer"
        }
    ],
    "homepage": "https://moselwal.de",
    "support": {
        "issues": "https://github.com/Moselwal-Digitalagentur/secret-resolver/issues",
        "source": "https://github.com/Moselwal-Digitalagentur/secret-resolver"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://gitlab.moselwal.io/api/v4/group/175/-/packages/composer/packages.json"
        }
    ],
    "require": {
        "php": "^8.5",
        "typo3/cms-core": "^14.0"
    },
    "require-dev": {
        "moselwal/dev": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Moselwal\\SecretResolver\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moselwal\\SecretResolver\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "secret_resolver"
        }
    },
    "scripts": {
        "test": "phpunit -c Tests/phpunit.xml --testsuite Unit",
        "phpstan": "phpstan analyse",
        "deptrac": "deptrac analyse"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "phpstan/extension-installer": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true
        }
    }
}
